 (defn- ascii-digit?
   [c]
-  (let [n (int (if (string? c) (first c) c))]
+  (let [n (if (string? c) (.charCodeAt c 0) (int c))]
     (<= 48 n 57)))
 
 (defn- name-start?
@@ -83,7 +83,7 @@
 
 (defn- digit-value
   [c radix]
-  (let [n (int (if (string? c) (first c) c))
+  (let [n (if (string? c) (.charCodeAt c 0) (int c))
