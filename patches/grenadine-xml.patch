--- a/grenadine/xml.cljc
+++ b/grenadine/xml.cljc
@@ -47,12 +47,12 @@
 
 (defn- ascii-letter?
   [c]
-  (let [n (int (if (string? c) (first c) c))]
+  (let [n (if (string? c) (.charCodeAt c 0) (int c))]
